<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="arch-draw studio preset" version="24.0.0" type="device">
  <diagram id="studio-bpmn-example" name="Order process">
    <mxGraphModel dx="780" dy="300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="780" pageHeight="300" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="start-received" value="Order received" style="ellipse;aspect=fixed;html=1;fillColor=#ffffff;strokeColor=#18202b;strokeWidth=1.5;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=2;fontSize=11.5;fontColor=#5a6575;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600;" parent="1" vertex="1">
          <mxGeometry x="40" y="70" width="40" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="task-validate" value='&lt;span style="font-weight:600"&gt;Validate order&lt;/span&gt;' style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3ccd7;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=13;fontColor=#18202b;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600;" parent="1" vertex="1">
          <mxGeometry x="120" y="60" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="gateway-valid" value="Valid?" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#18202b;strokeWidth=1.5;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;spacingBottom=2;fontSize=11.5;fontColor=#5a6575;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600;" parent="1" vertex="1">
          <mxGeometry x="280" y="70" width="40" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="task-reserve" value='&lt;span style="font-weight:600"&gt;Reserve stock&lt;/span&gt;' style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3ccd7;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=13;fontColor=#18202b;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600;" parent="1" vertex="1">
          <mxGeometry x="380" y="60" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="task-notify" value='&lt;span style="font-weight:600"&gt;Notify customer&lt;/span&gt;' style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3ccd7;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=13;fontColor=#18202b;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600;" parent="1" vertex="1">
          <mxGeometry x="540" y="60" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="end-confirmed" value="Order confirmed" style="ellipse;aspect=fixed;html=1;fillColor=#ffffff;strokeColor=#18202b;strokeWidth=3;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=2;fontSize=11.5;fontColor=#5a6575;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600;" parent="1" vertex="1">
          <mxGeometry x="700" y="70" width="40" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="error-end-rejected" value="Order rejected" style="ellipse;aspect=fixed;html=1;fillColor=#ffffff;strokeColor=#b3362b;strokeWidth=3;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=2;fontSize=11.5;fontColor=#b3362b;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600;" parent="1" vertex="1">
          <mxGeometry x="280" y="200" width="40" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="flow-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=9;strokeColor=#18202b;strokeWidth=1.5;fontSize=11.5;fontColor=#18202b;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="start-received" target="task-validate" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="flow-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=9;strokeColor=#18202b;strokeWidth=1.5;fontSize=11.5;fontColor=#18202b;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="task-validate" target="gateway-valid" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="flow-yes" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=9;strokeColor=#18202b;strokeWidth=1.5;fontSize=11.5;fontColor=#18202b;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="gateway-valid" target="task-reserve" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="flow-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=9;strokeColor=#18202b;strokeWidth=1.5;fontSize=11.5;fontColor=#18202b;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="task-reserve" target="task-notify" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="flow-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=9;strokeColor=#18202b;strokeWidth=1.5;fontSize=11.5;fontColor=#18202b;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="task-notify" target="end-confirmed" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="flow-no" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=9;strokeColor=#b3362b;strokeWidth=1.6;fontSize=11.5;fontColor=#b3362b;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600;verticalAlign=middle;align=left;spacingBottom=0;spacingLeft=6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="gateway-valid" target="error-end-rejected" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
